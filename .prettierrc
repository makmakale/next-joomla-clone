{
  "printWidth": 128,
  "tabWidth": 4,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "avoid",
  "endOfLine": "auto",
  "importOrder": [
    "^dotenv/*",
    "^react$",
    "^next/(.*)$",
    "<THIRD_PARTY_MODULES>",
    "^(?!.*\\.(c|le|sc)ss$).*@/cms/(.*)$",
    "^(?!.*\\.(c|le|sc)ss$).*@/libraries/(.*)$",
    "^(?!.*\\.(c|le|sc)ss$).*[./].*$",
    "\\.(c|le|sc)ss$"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "plugins": [
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ]
}
